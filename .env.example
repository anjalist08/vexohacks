# Copy to .env (cp .env.example .env) and fill in, or export these in your shell.
# .env is gitignored. Never commit it, never paste a key into the map page, a prompt or GitHub.
# VEXO_ names on purpose: the code never reads generic GEMINI_API_KEY / OPENAI_API_KEY,
# which may hold someone's personal key (see keys.py).
VEXO_DEEPGRAM_API_KEY=
VEXO_GEMINI_API_KEY=
VEXO_ELEVENLABS_API_KEY=
